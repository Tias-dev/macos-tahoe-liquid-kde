# Gentoo base image with Qt6 pre-emerged. Built ONCE (manually or
# monthly) by .github/workflows/build-gentoo-base.yml and pushed to
# GHCR. The lightweight tests/containers/Dockerfile.gentoo FROMs this
# so ordinary CI does not rebuild the SDK from source.
#
# This Dockerfile is intentionally heavy: it emerges qtbase + qttools
# with all the autounmask + USE flag fixes the source build needs.
# Don't reference it from the cross-distro CI matrix directly — that
# would defeat the whole point.

ARG GENTOO_BASE=gentoo/stage3:systemd
FROM ${GENTOO_BASE} AS configured

RUN emerge-webrsync && \
    eselect profile set default/linux/amd64/23.0/desktop/plasma/systemd && \
    echo 'FEATURES="${FEATURES} getbinpkg binpkg-multi-instance buildpkg"' >> /etc/portage/make.conf && \
    # Disable 32-bit ABI globally. The default multilib stage3 has
    # ABI_X86="64 32" which causes fontconfig / harfbuzz / freetype
    # to demand expat[abi_x86_32]; expat's local USE doesn't expose
    # that, and the chain dead-ends in
    # `>=dev-libs/expat-2.1.0-r3[abi_x86_32(-),abi_x86_64(-)]`
    # autounmask that cannot resolve. The theme stack doesn't need
    # 32-bit anywhere, so forcing the no-multilib ABI is the
    # honest fix instead of papering over individual packages.
    echo 'ABI_X86="64"' >> /etc/portage/make.conf && \
    mkdir -p /etc/portage/package.mask && \
    # Mesa's current compiler requires the LLVM 22 libclc series.
    echo '>=llvm-runtimes/libclc-23' > /etc/portage/package.mask/mttkde-sdk && \
    echo '*/*  ~amd64' > /etc/portage/package.accept_keywords/all && \
    echo 'x11-libs/libxkbcommon X' > /etc/portage/package.use/libxkbcommon && \
    # libcanberra is a kde-plasma/kwin dep; its USE="udev" requires
    # USE="alsa" (REQUIRED_USE: udev? ( alsa )). Without this, emerge
    # bails on a REQUIRED_USE constraint instead of letting autounmask
    # resolve it (autounmask doesn't touch REQUIRED_USE).
    echo 'media-libs/libcanberra alsa' > /etc/portage/package.use/libcanberra && \
    # Pre-seed the USE flags emerge would otherwise punt to autounmask.
    # `--autounmask-continue` writes these and exits 1 on this portage
    # version, so we skip the autounmask round-trip by writing them up
    # front. Sourced from the autounmask output of the first build
    # against a fresh ::gentoo snapshot.
    printf '%s\n' \
        'dev-python/pillow -truetype' \
        'dev-qt/qtbase opengl wayland cups libproxy icu' \
        'dev-qt/qttools qml qdoc llvm_slot_22 -llvm_slot_17 -llvm_slot_18 -llvm_slot_19 -llvm_slot_20 -llvm_slot_21' \
        'dev-qt/qt5compat qml' \
        'dev-qt/qtmultimedia qml opengl' \
        'dev-qt/qtquick3d opengl' \
        'kde-frameworks/kconfig qml dbus' \
        'kde-frameworks/kguiaddons wayland' \
        'kde-frameworks/kidletime wayland' \
        'kde-frameworks/kwindowsystem wayland X' \
        'kde-frameworks/kcoreaddons dbus' \
        'kde-frameworks/prison qml' \
        'kde-frameworks/sonnet qml' \
        'media-libs/mesa wayland' \
        'media-libs/libglvnd X' \
        'media-libs/libepoxy X' \
        'media-libs/freetype X' \
        'media-libs/fontconfig X' \
        'x11-libs/cairo X opengl' \
        'x11-base/xwayland libei' \
        'sys-apps/dbus X' \
        'sys-apps/systemd policykit' \
        'sys-auth/polkit systemd' \
        'llvm-runtimes/libclc spirv' \
        'dev-util/mesa_clc -debug' \
        > /etc/portage/package.use/mttkde-plasma && \
    getuto

RUN printf 'gentoo-sdk\n' > /etc/mttkde-sdk-build
COPY tests/containers/gentoo_sdk_stage.py /usr/local/libexec/gentoo_sdk_stage.py

FROM configured AS sdk
COPY tests/containers/gentoo-sdk-packages.json /usr/local/share/gentoo-sdk-packages.json
ENV MTTKDE_GENTOO_SDK_BUILD=1
RUN python3 /usr/local/libexec/gentoo_sdk_stage.py toolchain
RUN python3 /usr/local/libexec/gentoo_sdk_stage.py qtbase
RUN python3 /usr/local/libexec/gentoo_sdk_stage.py qttools
RUN python3 /usr/local/libexec/gentoo_sdk_stage.py frameworks
RUN python3 /usr/local/libexec/gentoo_sdk_stage.py plasma
RUN python3 /usr/local/libexec/gentoo_sdk_stage.py verify
